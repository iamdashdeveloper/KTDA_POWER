generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model ProjectMember {
  projectId String
  userId    String
  roleType  String  @default("viewer")
  invitedBy String?
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

model Company {
  id          String                   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  location    Unsupported("geometry")?
  metadata    Json                     @default("{}")
  images      String[]                 @default([])
  articles    Article[]
  projects    Project[]
  roles       Role[]
  users       User[]
}

model User {
  id                String            @id @default(cuid())
  companyId         String
  email             String            @unique
  password          String
  firstName         String
  lastName          String
  avatarUrl         String?
  position          String
  bio               String?
  isEmailVerified   Boolean           @default(false)
  verificationToken String?           @unique
  tokenExpiresAt    DateTime?
  lastLogin         DateTime?
  updatedAt         DateTime          @updatedAt
  createdAt         DateTime          @default(now())
  metadata          Json              @default("{}")
  activities        ActivityUser[]
  chats             ChatParticipant[]
  issueAssignments  IssueAssignment[]
  issueUpdates      IssueUpdate[]
  sentMessages      Message[]
  notifications     Notification[]    @relation("Recipient")
  sentNotifications Notification[]    @relation("Sender")
  projectMembers    ProjectMember[]
  company           Company           @relation(fields: [companyId], references: [id])
  roles             UserRole[]
}

model Role {
  id          String           @id @default(cuid())
  companyId   String?
  name        String
  company     Company?         @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  slug  String           @unique
  alias String
  roles RolePermission[]
}

model Project {
  id          String                   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime                 @default(now())
  location    Unsupported("geometry")?
  metadata    Json                     @default("{}")
  status      String?
  images      String[]                 @default([])
  activities  Activity[]
  articles    Article[]
  chatRooms   ChatRoom[]
  complaints  Complaint[]
  issues      Issue[]
  columns     KanbanColumn[]
  company     Company                  @relation(fields: [companyId], references: [id])
  members     ProjectMember[]
}

model Feature {
  id          String                   @id @default(cuid())
  projectId   String?
  name        String
  geometry    Unsupported("geometry")?
  details     Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  images      String[]                 @default([])
  parentId    String?
  parent      Feature?                 @relation("FeatureHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subFeatures Feature[]                @relation("FeatureHierarchy")
  issues      Issue[]
  schedules   MaintenanceSchedule[]
}

model MaintenanceSchedule {
  id           String    @id @default(cuid())
  featureId    String
  title        String
  intervalDays Int
  lastRun      DateTime?
  nextRun      DateTime
  taskTemplate Json      @default("{}")
  createdAt    DateTime  @default(now())
  feature      Feature   @relation(fields: [featureId], references: [id])
}

model KanbanColumn {
  id         String     @id @default(cuid())
  projectId  String
  name       String
  position   Int
  color      String?
  activities Activity[]
  project    Project    @relation(fields: [projectId], references: [id])
}

model Activity {
  id         String         @id @default(cuid())
  uuid       String         @unique @default(uuid())
  projectId  String
  columnId   String?
  title      String
  position   Int            @default(0)
  details    Json           @default("{\"tags\": [], \"subtasks\": []}")
  images     String[]       @default([])
  startTime  DateTime?
  endTime    DateTime?
  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())
  column     KanbanColumn?  @relation(fields: [columnId], references: [id])
  project    Project        @relation(fields: [projectId], references: [id])
  assignedTo ActivityUser[]
}

model Issue {
  id          String                   @id @default(cuid())
  projectId   String
  featureId   String?
  title       String
  status      String                   @default("OPEN")
  priority    Int                      @default(0)
  images      String[]                 @default([])
  createdAt   DateTime                 @default(now())
  description String?
  location    Unsupported("geometry")?
  metadata    Json                     @default("{}")
  feature     Feature?                 @relation(fields: [featureId], references: [id])
  project     Project                  @relation(fields: [projectId], references: [id])
  assignments IssueAssignment[]
  updates     IssueUpdate[]
}

model IssueUpdate {
  id           String   @id @default(cuid())
  issueId      String
  userId       String
  content      String
  images       String[] @default([])
  statusChange String?
  createdAt    DateTime @default(now())
  issue        Issue    @relation(fields: [issueId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model ChatRoom {
  id           String            @id @default(cuid())
  projectId    String?
  name         String?
  isGroup      Boolean           @default(false)
  createdAt    DateTime          @default(now())
  participants ChatParticipant[]
  project      Project?          @relation(fields: [projectId], references: [id])
  messages     Message[]
}

model Message {
  id            String   @id @default(cuid())
  roomId        String
  senderId      String?
  content       String?
  attachmentUrl String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  room          ChatRoom @relation(fields: [roomId], references: [id])
  sender        User?    @relation(fields: [senderId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  senderId    String?
  type        String
  title       String
  body        String?
  linkUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation("Recipient", fields: [recipientId], references: [id])
  sender      User?    @relation("Sender", fields: [senderId], references: [id])
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model ActivityUser {
  activityId String
  userId     String
  activity   Activity @relation(fields: [activityId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([activityId, userId])
}

model IssueAssignment {
  issueId String
  userId  String
  issue   Issue  @relation(fields: [issueId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@id([issueId, userId])
}

model ChatParticipant {
  roomId String
  userId String
  room   ChatRoom @relation(fields: [roomId], references: [id])
  user   User     @relation(fields: [userId], references: [id])

  @@id([roomId, userId])
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  excerpt   String?
  images    String[] @default([])
  companyId String?
  projectId String?
  author    String?
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])
}

model GuraCadastre {
  id         Int                      @id @default(autoincrement())
  geometry   Unsupported("geometry")?
  entity     String?                  @db.VarChar
  handle     String?                  @db.VarChar
  layer      String?                  @db.VarChar
  lyrfrzn    String?                  @db.VarChar
  lyrlock    String?                  @db.VarChar
  lyron      String?                  @db.VarChar
  lyrvpfrzn  String?                  @db.VarChar
  lyrhandle  String?                  @db.VarChar
  color      String?                  @db.VarChar
  entcolor   String?                  @db.VarChar
  lyrcolor   String?                  @db.VarChar
  blkcolor   String?                  @db.VarChar
  linetype   String?                  @db.VarChar
  entlinetyp String?                  @db.VarChar
  lyrlntype  String?                  @db.VarChar
  blklinetyp String?                  @db.VarChar
  ltscale    String?                  @db.VarChar
  elevation  String?                  @db.VarChar
  thickness  String?                  @db.VarChar
  linewt     String?                  @db.VarChar
  entlinewt  String?                  @db.VarChar
  lyrlinewt  String?                  @db.VarChar
  blklinewt  String?                  @db.VarChar
  refname    String?                  @db.VarChar
  extx       String?                  @db.VarChar
  exty       String?                  @db.VarChar
  extz       String?                  @db.VarChar
  docname    String?                  @db.VarChar
  docpath    String?                  @db.VarChar
  doctype    String?                  @db.VarChar
  docver     String?                  @db.VarChar
  docupdate  String?                  @db.VarChar
  docid      String?                  @db.VarChar
  globalwidt String?                  @db.VarChar
  shape_leng String?                  @db.VarChar

  @@index([geometry], map: "gura_cadastre_geometry_geom_idx", type: Gist)
  @@map("gura_cadastre")
}

model Owner {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  phone      String?
  address    String?
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  complaints Complaint[]
  feedbacks  Feedback[]
  parcels    Parcel[]
}

model Parcel {
  id          String                   @id @default(cuid())
  ownerId     String
  name        String?
  description String?
  geometry    Unsupported("geometry")?
  area        Float?
  status      String                   @default("active")
  metadata    Json                     @default("{}")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  complaints  Complaint[]
  feedbacks   Feedback[]
  owner       Owner                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Complaint {
  id            String     @id @default(cuid())
  complaintType String
  description   String
  severity      String     @default("medium")
  status        String     @default("open")
  metadata      Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  name          String
  phoneNumber   String
  plotNumber    String?
  projectId     String?
  ownerId       String
  parcelId      String
  owner         Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parcel        Parcel     @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  project       Project?   @relation(fields: [projectId], references: [id])
  feedbacks     Feedback[]
}

model Feedback {
  id           String     @id @default(cuid())
  complaintId  String?
  parcelId     String?
  ownerId      String
  feedbackType String
  message      String
  rating       Int?
  metadata     Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  complaint    Complaint? @relation(fields: [complaintId], references: [id])
  owner        Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parcel       Parcel?    @relation(fields: [parcelId], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
model HydroModel {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  parentModelId String?       @db.Uuid
  objects       HydroObject[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("hydro_models")
}

model HydroObject {
  id        String     @id @default(uuid()) @db.Uuid
  modelId   String     @db.Uuid
  model     HydroModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name      String
  type      String     
  data      Json       @default("{}")

  @@unique([modelId, name])
  @@map("hydro_objects")
}